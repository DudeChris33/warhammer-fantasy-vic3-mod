# live in mapgen/.gitignore and stay there.

*.log
*.bak

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Reference imagery for the source-driven map pipeline. Was committed in full
# via Git LFS as of 2026-09-03 to sync between two devices; reverted 2026-09-15
# once work moved to a single machine (the second can't run the game to test),
# and purged from git history entirely in board #4608. sources/ now lives on
# disk only, untracked. mapgen/SOURCES.md's SHA-256 manifest + mapgen/registration/*.json
# remain the provenance record.
sources/*
sources/*/*
!sources/originals/terraqueous_globe_reprojected.png
!sources/originals/tww3_ie_parchment.jpg
!sources/oldworld-first/terraqueous_globe_reprojected - full.ora

planning/.cache/
.claude/maestro.json
.claude/skills/maestro-**/
.claude/skills/sites-verify/

# Claude renders, previews, QA output (local only)
scratchpad/

# Generated outputs that rebuild byte-for-byte from tracked inputs (verified 2026-10-23: regenerated in a
# clean worktree with these removed, git diff against HEAD was empty). After a fresh clone, run
# generate_state_history.py, generate_pop_history.py, generate_country_history.py,
# generate_building_history.py and generate_map_locators.py (in that order) before deploy.ps1.
# NOT listed on purpose: map_data/state_regions, common/strategic_regions, the map loc and
# mapgen/derived/land_state_ids.json keep ids stable by overlap-matching the previously committed
# output, so they are not reproducible from scratch; PNG/DDS rasters depend on library versions;
# mapgen/derived/state_ownership.json is a checkpoint of Chris's painted map.
/common/history/states/
/common/history/pops/
/common/history/population/
/common/history/countries/
/common/history/buildings/
/gfx/map/map_object_data/generated_map_object_locators_*.txt
