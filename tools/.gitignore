# Local virtualenv for the toolchain — never committed (see requirements.txt).
.venv/

# Python bytecode caches.
__pycache__/
*.pyc

# Scratch output from run_fixture.py --check goes to the system temp dir,
# but ignore any stray local output dir just in case.
fixtures/_out/

# tools/derived/ holds generated artifacts. Most of it is a QA/preview render
# (preview_*, qa_*, ...) regenerable on demand and kept out of the repo. The
# committed deliverables are listed explicitly:
#   land_sea_mask.png         the coastline authority (S2); S3b cuts provinces from it
#   state_labels.png          the state-cell partition (S3a); S3b's direct input
#   state_labels_index.json   per-cell macro / area / coastal flag / provisional key
#   COVERAGE.md               the achieved-vs-target density report
# The two rasters and the index are consumed by later phases, so they have to
# travel with the repo; COVERAGE.md is the record of where the sources fall short.
derived/*
!derived/land_sea_mask.png
!derived/state_labels.png
!derived/state_labels_index.json
!derived/COVERAGE.md

# derived/named/ is the S3a-2 review deliverable from render_named_map.py
# --tiles: flat-tinted state cells drawn from our own pixels only (no source
# art), so — unlike the rest of derived/ — it is meant to be committed.
!derived/named/
!derived/named/*.png

# Kept as a worked example of the paired-anchor-dot registration workflow: the
# Empire tile of tww3_old_world_mod_parchment, warped through its 9 dots, with
# the current mask coastline overlaid via tools/qa_overlay.py. Our own
# generated composite, not third-party source art, so — unlike the raw dot
# images and crops under sources/dots/ (real reference imagery, rightly never
# committed) — this one has always been meant to travel with the repo.
!derived/empire_anchor_dot_warp_example.png

