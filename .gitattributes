# The fixture golden outputs are byte-for-byte regression fixtures: run_fixture.py
# regenerates them and diffs against the committed copies. Git must NOT normalize
# their line endings, or the regenerated (LF) bytes would differ from the checked-out
# copies and the determinism check would fail on machines with autocrlf enabled.
tools/fixtures/expected/** -text
tools/fixtures/ingest/expected/** -text
tools/fixtures/boundary/expected/** -text
tools/fixtures/boundary/*.png binary

# The committed derived rasters are generated bitmaps, diffed byte-for-byte by
# the generators' own determinism check. Same reasoning as above.
tools/derived/*.png binary
# The map-editor artifacts under map_data/ are written by the Victoria 3 client,
# not authored here, and must be checked out exactly as it wrote them.
# `heightmap.heightmap` is a text descriptor the editor emits with a BOM and LF
# endings; letting git normalize it to CRLF would mean the working copy no longer
# matches the bytes the editor produced (and would show as a spurious diff after
# every repack). The PNG/DAT siblings are binary and are marked so explicitly.
map_data/heightmap.heightmap -text
map_data/nodes.dat binary
map_data/*.png binary
map_data/heightmap.png filter=lfs diff=lfs merge=lfs -text
map_data/packed_heightmap.png filter=lfs diff=lfs merge=lfs -text
map_data/nodes.dat filter=lfs diff=lfs merge=lfs -text
map_data/indirection_heightmap.png filter=lfs diff=lfs merge=lfs -text
map_data/heightmap.heightmap filter=lfs diff=lfs merge=lfs -text
map_data/rivers.png filter=lfs diff=lfs merge=lfs -text
map_data/provinces.png filter=lfs diff=lfs merge=lfs -text
